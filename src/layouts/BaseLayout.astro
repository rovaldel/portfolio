---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PersistentQuery from '../components/layout/PersistentQuery.astro';
import ConversationTemplates from '../components/layout/ConversationTemplates.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import ArticleHeader from '../components/journal/ArticleHeader.astro';
import { byPath, canonicalUrl } from '../lib/routes';
import { useLocale } from '../lib/locale';
import { pathFor } from '../lib/i18n';
import '../styles/themes.css';
import '../styles/motion.css';
import '../styles/global.css';
import '../styles/refinements.css';
import '../styles/chat.css';
import '../styles/mobile.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  overlayMode?: boolean;
  articleMode?: boolean;
  journalIndexMode?: boolean;
  modalMode?: boolean;
}
const { locale, t, c } = useLocale(Astro.url);
const { siteProfile, services, skillGroups } = c;
const currentPath = Astro.url.pathname;
const surface = byPath(currentPath);
const routeId = surface?.routeId;
const {
  title = surface?.title ?? t.layout.notFoundTitle,
  description = surface?.description ?? t.layout.notFoundDescription,
  noindex = surface ? !surface.indexable : true,
  overlayMode = false,
  articleMode = false,
  journalIndexMode = false,
  modalMode = false,
} = Astro.props;
const canonical = canonicalUrl(surface?.canonicalPath ?? currentPath);
const personId = canonicalUrl(pathFor('home', 'es') + '#rodrigo');
const websiteId = canonicalUrl(pathFor('home', 'es') + '#website');
const structuredData = surface?.indexable
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': personId,
          name: siteProfile.fullName,
          alternateName: siteProfile.displayName,
          url: canonicalUrl(pathFor('home', locale)),
          jobTitle: siteProfile.primaryRole,
          description: siteProfile.professionalSummary,
          image: canonicalUrl(siteProfile.portrait.src),
          sameAs: [siteProfile.channels.linkedin.href],
          knowsAbout: skillGroups.flatMap((group) => group.skills.map((skill) => skill.name)),
          homeLocation: { '@type': 'Place', name: t.layout.location },
        },
        {
          '@type': 'WebSite',
          '@id': websiteId,
          name: t.layout.siteName,
          url: canonicalUrl(pathFor('home', locale)),
          inLanguage: locale,
          publisher: { '@id': personId },
        },
        {
          '@type': routeId === 'about' ? 'ProfilePage' : surface.kind === 'article' ? 'Article' : 'WebPage',
          '@id': canonical + '#page',
          name: title,
          headline: title,
          description,
          url: canonical,
          inLanguage: locale,
          isPartOf: { '@id': websiteId },
          about: { '@id': personId },
          author: { '@id': personId },
          ...(routeId === 'about' ? { mainEntity: { '@id': personId } } : {}),
        },
        ...(routeId === 'services'
          ? services.map((service) => ({
              '@type': 'Service',
              '@id': canonical + '#' + service.slug,
              name: service.title,
              description: service.description,
              provider: { '@id': personId },
              availableChannel: {
                '@type': 'ServiceChannel',
                serviceUrl: canonicalUrl(pathFor('contact', locale)),
              },
            }))
          : []),
        ...(routeId === 'home'
          ? []
          : [
              {
                '@type': 'BreadcrumbList',
                itemListElement: [
                  {
                    '@type': 'ListItem',
                    position: 1,
                    name: t.layout.breadcrumbHome,
                    item: canonicalUrl(pathFor('home', locale)),
                  },
                  { '@type': 'ListItem', position: 2, name: surface.navigationLabel, item: canonical },
                ],
              },
            ]),
      ],
    }).replace(/</g, '\\u003c')
  : '';
const bodyClass =
  articleMode || journalIndexMode
    ? 'is-article'
    : overlayMode
      ? 'is-home legal-overlay-mode'
      : routeId === 'home'
        ? 'is-home'
        : modalMode
          ? 'is-modal-page'
          : routeId === 'contact'
            ? 'is-contact'
            : undefined;
const contentClass =
  routeId === 'home'
    ? 'container'
    : `conversation-container${routeId === 'services' ? ' conversation-container--services' : ''}`;
---

<!doctype html>
<html lang={t.htmlLang} data-theme="rioja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      surface && (
        <>
          <link rel="alternate" hreflang="es" href={canonicalUrl(surface.alternates.es)} />
          <link rel="alternate" hreflang="en" href={canonicalUrl(surface.alternates.en)} />
          <link rel="alternate" hreflang="x-default" href={canonicalUrl(surface.alternates.es)} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="author" content={siteProfile.fullName} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      surface?.indexable && (
        <>
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:type" content={surface.kind === 'article' ? 'article' : 'website'} />
          <meta property="og:site_name" content={siteProfile.displayName} />
          <meta property="og:locale" content={t.ogLocale} />
          <meta property="og:image" content={canonicalUrl('/images/rodrigo-valdelvira.png')} />
          <meta property="og:image:alt" content={siteProfile.portrait.alt} />
          <meta name="twitter:card" content="summary" />
          <meta name="twitter:image" content={canonicalUrl('/images/rodrigo-valdelvira.png')} />
          <script type="application/ld+json" set:html={structuredData} />
        </>
      )
    }
    <script is:inline src="/scripts/theme-init.js"></script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href={modalMode ? '#modal-content' : overlayMode ? '#legal-title' : '#contenido'}
      >{t.layout.skipLink}</a
    >
    {
      articleMode || journalIndexMode ? (
        <div class="article-shell">
          <ArticleHeader indexMode={journalIndexMode || routeId === 'journal'} />
          <main
            id="contenido"
            class:list={['article-main', journalIndexMode && 'article-main--index']}
            tabindex="0"
          >
            <div class:list={['article-container', journalIndexMode && 'article-container--wide']}>
              <slot />
            </div>
          </main>
        </div>
      ) : (
        <>
          <div class="site-shell" inert={overlayMode || modalMode}>
            <Header />
            <main id="contenido" tabindex="0">
              {overlayMode ? (
                <div class="container">
                  <HomeHero backdrop />
                </div>
              ) : (
                <div class={contentClass} data-route-content>
                  <slot />
                </div>
              )}
              {!overlayMode && !modalMode && (
                <section
                  class="conversation-container conversation-thread"
                  data-conversation-thread
                  role="log"
                  aria-label={t.layout.threadLabel}
                  aria-live="polite"
                  aria-relevant="additions"
                  hidden
                />
              )}
            </main>
            <PersistentQuery />
            <Footer />
            {!overlayMode && !modalMode && <ConversationTemplates />}
          </div>
          {!overlayMode && !modalMode && <div data-conversation-modal-root />}
        </>
      )
    }
    {modalMode && <slot name="modal" />}
    {
      overlayMode && (
        <div class="legal-modal-backdrop">
          <dialog class="legal-modal" open aria-modal="true" aria-labelledby="legal-title" data-legal-dialog>
            <a class="modal-close" href={pathFor('home', locale)} aria-label={t.layout.closeLegal}>
              ×
            </a>
            <slot />
          </dialog>
        </div>
      )
    }
  </body>
</html>
