---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useLocale } from '../lib/locale';

const { t, path } = useLocale(Astro.url);
---

<BaseLayout title={t.layout.notFoundTitle} noindex
  ><section class="page-intro">
    <p class="eyebrow">404</p><h1>{t.errors.notFoundHeading}</h1><p class="lead">
      {t.errors.notFoundLead}
    </p><div class="button-row">
      <a class="button button--fill" href={path('home')}>{t.errors.home}</a><a
        class="button button--quiet"
        href={path('projects')}>{t.errors.projects}</a
      ><a class="button button--quiet" href={path('contact')}>{t.errors.contact}</a>
    </div>
  </section></BaseLayout
>
