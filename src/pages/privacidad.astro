---
import LegalDocument from '../components/sections/LegalDocument.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { legalDocuments } from '../content/site';
const document = legalDocuments.find((item) => item.kind === 'privacy')!;
---

<BaseLayout noindex overlayMode>
  <LegalDocument document={document} />
</BaseLayout>
