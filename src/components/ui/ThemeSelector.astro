---
import { themes } from '../../lib/themes';
---

<div class="theme-wrapper" data-theme-selector data-current-theme="rioja">
  <button
    class="theme-trigger"
    type="button"
    aria-label="Cambiar tema visual"
    aria-expanded="false"
    aria-controls="theme-menu"
    data-theme-trigger
  >
    <svg
      class="theme-trigger__icon"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><path
        d="M12 3a9 9 0 1 0 0 18h1.2a1.8 1.8 0 0 0 1.2-3.1 1.5 1.5 0 0 1 1-2.6H17a5 5 0 0 0 5-5c0-4-4.5-7.3-10-7.3Z"
      ></path><circle cx="7.5" cy="11" r=".8"></circle><circle cx="10" cy="6.8" r=".8"></circle><circle
        cx="15.2"
        cy="7.8"
        r=".8"></circle><circle cx="17.2" cy="11.6" r=".8"></circle></svg
    >
    <span>Tema</span><span class="theme-trigger__swatch" aria-hidden="true"></span>
  </button>
  <div
    id="theme-menu"
    class="theme-menu"
    role="group"
    aria-label="Paleta de temas visuales"
    data-theme-menu
    hidden
  >
    {
      themes.map((theme) => (
        <button
          class="theme-option"
          type="button"
          aria-pressed={theme.id === 'rioja' ? 'true' : 'false'}
          data-theme-id={theme.id}
        >
          <>
            <span class:list={['swatch', `swatch--${theme.id}`]} />
            <span>{theme.label}</span>
          </>
        </button>
      ))
    }
  </div>
</div>
<script src="../../scripts/theme-selector.ts"></script>
