---
import ConversationPage from '../layout/ConversationPage.astro';
import Services from '../sections/Services.astro';
import ServiceDialog from '../sections/ServiceDialog.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useLocale } from '../../lib/locale';

const { t, c, path, actionLabel } = useLocale(Astro.url);
const label = actionLabel('services');
const requestedService = Astro.url.searchParams.get('servicio');
const selectedService = c.services.find((service) => service.slug === requestedService);
---

<BaseLayout modalMode={Boolean(selectedService)}>
  <ConversationPage action={label} label={label} modifier="conversation-page--services">
    <p class="conversation-lead">{t.conversation.servicesLead}</p>
    <Services />
    <div class="conversation-actions">
      <a class="button button--fill" href={path('projects')}>{t.conversation.viewProjects}</a>
      <a class="button button--quiet" href={path('contact') + '?asunto=agentes-y-chatbots-ia'}
        >{t.conversation.talkOpportunity}</a
      >
    </div>
  </ConversationPage>
  {
    selectedService && (
      <Fragment slot="modal">
        <div class="modal-backdrop" data-modal-backdrop>
          <ServiceDialog service={selectedService} />
        </div>
      </Fragment>
    )
  }
</BaseLayout>
<script src="../../scripts/service-dialog.ts"></script>
