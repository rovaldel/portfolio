---
import Article from '../journal/Article.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { selectCompletePublishedArticles } from '../../lib/content';
import { useLocale } from '../../lib/locale';

const { locale } = useLocale(Astro.url);
const [article] = selectCompletePublishedArticles(await getCollection('bitacora'), locale);
if (!article) throw new Error('Falta el artículo aprobado de Bitácora.');
const { Content: ArticleContent } = await render(article);
const frontmatter = article.data;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} articleMode>
  <Article Content={ArticleContent} data={frontmatter} />
</BaseLayout>
