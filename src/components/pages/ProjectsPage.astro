---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConversationPage from '../layout/ConversationPage.astro';
import ProjectIndex from '../projects/ProjectIndex.astro';
import { useLocale } from '../../lib/locale';

const { t, actionLabel } = useLocale(Astro.url);
const label = actionLabel('projects');
---

<BaseLayout>
  <ConversationPage action={label} label={label}>
    <p class="conversation-lead">{t.conversation.projectsLead}</p>
    <ProjectIndex />
  </ConversationPage>
</BaseLayout>
