---
import { useLocale } from '../../lib/locale';

interface Props {
  action?: string;
  label?: string;
  heading?: string;
  hideHeading?: boolean;
  modifier?: string;
}

const { t, c } = useLocale(Astro.url);
const {
  action,
  label = t.layout.responseLabel,
  heading = action,
  hideHeading = false,
  modifier = '',
} = Astro.props;
---

<section class:list={[['conversation-page', modifier]]} aria-label={label}>
  {
    heading && (
      <h1 class:list={['conversation-user', hideHeading && 'conversation-page__heading--visually-hidden']}>
        {heading}
      </h1>
    )
  }
  <article class="conversation-message">
    <img
      class="conversation-message__avatar"
      src={c.siteProfile.portrait.src}
      alt=""
      width="34"
      height="34"
    />
    <div class="conversation-message__body"><slot /></div>
  </article>
</section>
