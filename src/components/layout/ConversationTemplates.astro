---
import Profile from '../sections/Profile.astro';
import Skills from '../sections/Skills.astro';
import Services from '../sections/Services.astro';
import Experience from '../sections/Experience.astro';
import Education from '../sections/Education.astro';
import ContactInfo from '../sections/ContactInfo.astro';
import ProjectIndex from '../projects/ProjectIndex.astro';
import ProjectDialog from '../projects/ProjectDialog.astro';
import ServiceDialog from '../sections/ServiceDialog.astro';
import { projects, services } from '../../content/site';
---

<div class="conversation-templates" aria-hidden="true">
  <template data-conversation-template="profile">
    <p class="conversation-lead">
      Un perfil que combina ingeniería, datos e inteligencia artificial aplicada.
    </p>
    <Profile />
    <div class="conversation-actions">
      <a class="button button--fill" href="/habilidades" data-conversation-followup="skills"
        >Ver habilidades</a
      >
      <a class="button button--quiet" href="/experiencia" data-conversation-followup="experience"
        >Ver trayectoria</a
      >
    </div>
  </template>
  <template data-conversation-template="skills">
    <p class="conversation-lead">
      Estas son las herramientas y tecnologías que uso a diario, con foco en fiabilidad y puesta en
      producción.
    </p>
    <Skills />
    <div class="conversation-actions">
      <a class="button button--fill" href="/proyectos" data-conversation-followup="projects">Ver proyectos</a>
      <a class="button button--quiet" href="/Rodrigo-Valdelvira-CV.pdf" download="Rodrigo-Valdelvira-CV.pdf"
        >Descargar CV</a
      >
    </div>
  </template>
  <template data-conversation-template="services">
    <p class="conversation-lead">
      Áreas en las que puedo aportar a un equipo de producto o ingeniería: del dato a una solución de IA en
      producción.
    </p>
    <Services />
    <div class="conversation-actions">
      <a class="button button--fill" href="/proyectos" data-conversation-followup="projects">Ver proyectos</a>
      <a
        class="button button--quiet"
        href="/contacto?asunto=agentes-y-chatbots-ia"
        data-conversation-followup="contact">Hablar de una oportunidad</a
      >
    </div>
  </template>
  <template data-conversation-template="projects">
    <p class="conversation-lead">
      Te muestro mi trabajo, proyecto a proyecto. Pulsa una tarjeta para ver la información completa.
    </p>
    <ProjectIndex />
  </template>
  <template data-conversation-template="experience">
    <p class="conversation-lead">
      Una trayectoria de ingeniería, producto, datos e inteligencia artificial aplicada.
    </p>
    <Experience />
  </template>
  <template data-conversation-template="education">
    <p class="conversation-lead">
      Formación técnica, datos, IA responsable e idiomas para trabajar en entornos internacionales.
    </p>
    <Education />
  </template>
  <template data-conversation-template="contact">
    <ContactInfo />
  </template>
  <template data-conversation-template="fallback">
    <p class="conversation-lead">No tengo una respuesta clara para eso. Puedo ayudarte con:</p>
    <div class="conversation-actions">
      <a class="button button--quiet" href="/proyectos" data-conversation-followup="projects">Proyectos</a>
      <a class="button button--quiet" href="/habilidades" data-conversation-followup="skills">Habilidades</a>
      <a class="button button--quiet" href="/experiencia" data-conversation-followup="experience"
        >Experiencia</a
      >
      <a class="button button--quiet" href="/contacto" data-conversation-followup="contact">Contacto</a>
    </div>
  </template>
  {
    services.map((service) => (
      <template data-service-dialog-template={service.slug}>
        <div class="modal-backdrop" data-conversation-dialog-backdrop>
          <ServiceDialog service={service} />
        </div>
      </template>
    ))
  }
  {
    projects.map((project) => (
      <template data-project-dialog-template={project.slug}>
        <div class="modal-backdrop" data-conversation-dialog-backdrop>
          <ProjectDialog project={project} />
        </div>
      </template>
    ))
  }
</div>
