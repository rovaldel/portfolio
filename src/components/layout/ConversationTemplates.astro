---
import Profile from '../sections/Profile.astro';
import Skills from '../sections/Skills.astro';
import Services from '../sections/Services.astro';
import Experience from '../sections/Experience.astro';
import Education from '../sections/Education.astro';
import ContactInfo from '../sections/ContactInfo.astro';
import ProjectIndex from '../projects/ProjectIndex.astro';
import ProjectDialog from '../projects/ProjectDialog.astro';
import ServiceDialog from '../sections/ServiceDialog.astro';
import { useLocale } from '../../lib/locale';

const { t, c, path } = useLocale(Astro.url);
const { projects, services } = c;
const q = t.query;
const v = t.conversation;
---

<div class="conversation-templates" aria-hidden="true">
  <template data-conversation-template="profile">
    <p class="conversation-lead">{v.profileLead}</p>
    <Profile />
    <div class="conversation-actions">
      <a class="button button--fill" href={path('skills')} data-conversation-followup="skills"
        >{v.viewSkills}</a
      >
      <a class="button button--quiet" href={path('experience')} data-conversation-followup="experience"
        >{v.viewExperience}</a
      >
    </div>
  </template>
  <template data-conversation-template="skills">
    <p class="conversation-lead">{v.skillsLead}</p>
    <Skills />
    <div class="conversation-actions">
      <a class="button button--fill" href={path('projects')} data-conversation-followup="projects"
        >{v.viewProjects}</a
      >
      <a class="button button--quiet" href="/Rodrigo-Valdelvira-CV.pdf" download="Rodrigo-Valdelvira-CV.pdf"
        >{t.header.cvDownload}</a
      >
    </div>
  </template>
  <template data-conversation-template="services">
    <p class="conversation-lead">{v.servicesLead}</p>
    <Services />
    <div class="conversation-actions">
      <a class="button button--fill" href={path('projects')} data-conversation-followup="projects"
        >{v.viewProjects}</a
      >
      <a
        class="button button--quiet"
        href={path('contact') + '?asunto=agentes-y-chatbots-ia'}
        data-conversation-followup="contact">{v.talkOpportunity}</a
      >
    </div>
  </template>
  <template data-conversation-template="projects">
    <p class="conversation-lead">{v.projectsLead}</p>
    <ProjectIndex />
  </template>
  <template data-conversation-template="experience">
    <p class="conversation-lead">{v.experienceLead}</p>
    <Experience />
  </template>
  <template data-conversation-template="education">
    <p class="conversation-lead">{v.educationLead}</p>
    <Education />
  </template>
  <template data-conversation-template="contact">
    <ContactInfo />
  </template>
  <template data-conversation-template="article">
    <p class="conversation-lead">{v.articleLead}</p>
    <a class="button button--quiet" href={path('journal.langgraph')}>{v.readArticle}</a>
  </template>
  <template data-conversation-template="fallback">
    <p class="conversation-lead">{v.fallbackLead}</p>
    <div class="conversation-actions">
      <a class="button button--quiet" href={path('projects')} data-conversation-followup="projects"
        >{q.followUps.projects}</a
      >
      <a class="button button--quiet" href={path('skills')} data-conversation-followup="skills"
        >{q.followUps.skills}</a
      >
      <a class="button button--quiet" href={path('experience')} data-conversation-followup="experience"
        >{q.followUps.experience}</a
      >
      <a class="button button--quiet" href={path('contact')} data-conversation-followup="contact"
        >{q.followUps.contact}</a
      >
    </div>
  </template>
  {
    services.map((service) => (
      <template data-service-dialog-template={service.slug}>
        <div class="modal-backdrop" data-conversation-dialog-backdrop>
          <ServiceDialog service={service} />
        </div>
      </template>
    ))
  }
  {
    projects.map((project) => (
      <template data-project-dialog-template={project.slug}>
        <div class="modal-backdrop" data-conversation-dialog-backdrop>
          <ProjectDialog project={project} />
        </div>
      </template>
    ))
  }
</div>
