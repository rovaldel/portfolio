---
import PortfolioActions from './PortfolioActions.astro';
---

<aside
  class="conversation-dock"
  id="consulta-langgraph"
  data-action-dock
  data-visual-anchor="query"
  aria-label="Explora el portfolio"
>
  <div class="conversation-dock__panel">
    <form class="query-form" id="portfolio-query-form" data-query-form aria-label="Consulta local">
      <span class="query-form__spark" aria-hidden="true"
        ><svg viewBox="0 0 24 24"
          ><path d="M12 2c.6 5.4 4.6 9.4 10 10-5.4.6-9.4 4.6-10 10-.6-5.4-4.6-9.4-10-10 5.4-.6 9.4-4.6 10-10Z"
          ></path></svg
        ></span
      >
      <label class="sr-only" for="portfolio-query">Escribe tu pregunta</label>
      <textarea
        id="portfolio-query"
        data-query-field
        maxlength="300"
        rows="1"
        aria-describedby="query-guidance query-count"
        placeholder="Pregúntame por mi experiencia, proyectos…"></textarea>
      <button class="query-submit" type="submit" data-query-submit aria-label="Enviar consulta">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 19V5M6 11l6-6 6 6"></path>
        </svg>
      </button>
      <span id="query-guidance" class="sr-only"
        >Máximo 300 caracteres. Enter envía; Shift+Enter añade una línea.</span
      >
      <span id="query-count" class="sr-only" data-query-count>0 de 300 caracteres</span>
      <span class="sr-only" data-query-limit role="status" aria-live="polite"></span>
    </form>
    <div class="conversation-dock__rule" aria-hidden="true"></div>
    <PortfolioActions />
    <section class="upcoming-resources" aria-label="Recursos">
      <span class="upcoming-resources__label">En preparación</span>
      <span class="upcoming-resources__item"
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M8 7V4h8v3M3 7h18v13H3zM3 12h18M10 12v3h4v-3"></path></svg
        >Toolkit IA <small>Próximamente</small></span
      >
      <a class="upcoming-resources__item" href="/bitacora"
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M12 5v15M12 5C8 2 3 3 3 3v15s5-1 9 2c4-3 9-2 9-2V3s-5-1-9 2Z"></path></svg
        >Bitácora <small>1 artículo</small></a
      >
    </section>
    <span class="sr-only" data-query-status role="status" aria-live="polite"></span>
  </div>
</aside>
<script src="../../scripts/portfolio-actions.ts"></script>
<script src="../../scripts/query.ts"></script>
<script src="../../scripts/conversation-dialogs.ts"></script>
