---
import ProjectDetail from './ProjectDetail.astro';
import type { Project } from '../../content/site';
import { useLocale } from '../../lib/locale';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { t, path } = useLocale(Astro.url);
---

<section
  class="project-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-modal-title"
  id="modal-content"
  tabindex="-1"
  data-project-dialog
>
  <a class="modal-close" href={path('projects')} aria-label={t.projects.close}>×</a>
  <h2 id="project-modal-title" class="sr-only">{t.projects.detailOf(project.title)}</h2>
  <ProjectDetail project={project} />
</section>
