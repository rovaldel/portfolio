---
import ProjectDetail from './ProjectDetail.astro';
import type { Project } from '../../content/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section
  class="project-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-modal-title"
  id="modal-content"
  tabindex="-1"
  data-project-dialog
>
  <a class="modal-close" href="/proyectos" aria-label="Cerrar detalle del proyecto">×</a>
  <h2 id="project-modal-title" class="sr-only">Detalle de {project.title}</h2>
  <ProjectDetail project={project} />
</section>
