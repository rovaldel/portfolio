---
import type { Project } from '../../content/site';
import { useLocale } from '../../lib/locale';
import ProjectCard from './ProjectCard.astro';

interface Props {
  activeSlug?: Project['slug'];
}

const { activeSlug } = Astro.props;
const { t, c } = useLocale(Astro.url);
const { projects } = c;
const activeProject = activeSlug ? projects.find((project) => project.slug === activeSlug) : projects[0];
const visibleProjects = activeSlug ? projects.filter((project) => project.slug === activeSlug) : projects;
---

{
  activeProject ? (
    <section class="stack project-index" aria-label={t.projects.label}>
      {visibleProjects.map((project) => (
        <div class="project-index__slide">
          <p class="project-index__position">
            {t.projects.position(project.position, projects.length)} <span aria-hidden="true">·</span>{' '}
            <strong>{project.title}</strong>
          </p>
          <ProjectCard project={project} />
        </div>
      ))}
    </section>
  ) : null
}
