---
import StableImage from '../ui/StableImage.astro';
import type { Project } from '../../content/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectHref = '/proyectos/' + project.slug;
---

<a
  class="card project-card"
  href={projectHref}
  data-project-open={project.slug}
  aria-haspopup="dialog"
  aria-label={'Abrir proyecto ' + project.title}
>
  <div class="project-card__content">
    <div class="project-card__media">
      <StableImage {...project.image} class="project-card__image" />
      <p class="tag project-card__status">{project.statusLabel}</p>
    </div>
    <div class="project-card__copy">
      <h2>{project.title}</h2>
      <p>{project.description}</p>
    </div>
  </div>
</a>
