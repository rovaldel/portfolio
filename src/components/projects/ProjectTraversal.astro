---
import type { Project } from '../../content/site';
import { useLocale } from '../../lib/locale';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { t, c, path } = useLocale(Astro.url);
const { projects } = c;
const currentIndex = project.position - 1;
const previous = project.position > 1 ? projects[currentIndex - 1] : null;
const next = project.position < projects.length ? projects[currentIndex + 1] : null;
---

<nav class="project-index__traversal" aria-label={t.projects.traversalLabel}>
  {
    previous && (
      <a
        class="button button--quiet"
        href={path(`project.${previous.slug}`)}
        data-project-previous={previous.slug}
        aria-label={t.projects.previousAria(previous.title)}
      >
        <span aria-hidden="true">←</span> {t.projects.previous}
      </a>
    )
  }
  {
    next && (
      <a
        class="button button--fill"
        href={path(`project.${next.slug}`)}
        data-project-next={next.slug}
        aria-label={t.projects.nextAria(next.title)}
      >
        {t.projects.next} <span aria-hidden="true">→</span>
      </a>
    )
  }
  <a class="button button--quiet" href={path('experience')} data-conversation-followup="experience"
    >{t.conversation.viewExperience}</a
  >
</nav>
