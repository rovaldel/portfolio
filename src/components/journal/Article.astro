---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { useLocale } from '../../lib/locale';

interface ArticleData {
  title: string;
  slug: string;
  excerpt: string;
  status: 'published';
  authorId: string;
  description: string;
  updatedAt?: Date;
  category: string;
  publishedAt: string | Date;
  author: string;
  readingMinutes: number;
}

interface Props {
  Content: AstroComponentFactory;
  data: ArticleData;
}

const { Content, data } = Astro.props;
const { t, locale } = useLocale(Astro.url);
const date = new Intl.DateTimeFormat(t.dateLocale, { day: '2-digit', month: 'short', year: 'numeric' })
  .format(new Date(data.publishedAt))
  .replaceAll('.', '');
const askHref = (locale === 'en' ? '/en' : '/') + '#consulta-langgraph';
---

<article class="article-content" data-visual-anchor="article">
  <div class="article-meta">
    <span class="article-meta__category">{data.category}</span>
    <time datetime={new Date(data.publishedAt).toISOString()}>{date}</time>
    <span aria-hidden="true">·</span>
    <span>{t.journal.minutes(data.readingMinutes)}</span>
    <span>{t.journal.by} {data.author}</span>
    <span class="article-meta__status">{t.journal.published}</span>
  </div>
  <h1>{data.title}</h1>
  <Content />
  <p class="article-query-action"><a href={askHref}>{t.journal.askAboutThis}</a></p>
</article>
