---
import { useLocale } from '../../lib/locale';

interface ArticleData {
  slug: string;
  title: string;
  description: string;
  excerpt: string;
  category: string;
  publishedAt: string | Date;
  readingMinutes: number;
}

interface Props {
  articles: ArticleData[];
}

const { articles } = Astro.props;
const { t, path } = useLocale(Astro.url);
const categories = [...new Set(articles.map((article) => article.category))];
const formatDate = (value: string | Date) =>
  new Intl.DateTimeFormat(t.dateLocale, { day: 'numeric', month: 'short', year: 'numeric' })
    .format(new Date(value))
    .replaceAll('.', '');
const articleHref = (slug: string) => path('journal') + '/' + slug;
---

<section class="journal-browser" aria-label={t.journal.browserLabel}>
  <div class="journal-filters" role="group" aria-label={t.journal.filterLabel}>
    <button class="conversation-dock__chip" type="button" data-journal-filter="all" aria-pressed="true"
      >{t.journal.all}</button
    >
    {
      categories.map((category) => (
        <button
          class="conversation-dock__chip"
          type="button"
          data-journal-filter={category}
          aria-pressed="false"
        >
          {category}
        </button>
      ))
    }
    <label class="journal-search">
      {t.journal.search}
      <input type="search" data-journal-search />
    </label>
  </div>
  <p data-journal-empty role="status" hidden>{t.journal.empty}</p>
  <div class="journal-list" data-journal-list>
    {
      articles.map((article) => (
        <article class="journal-card" data-journal-entry data-category={article.category}>
          <div class="journal-card__body">
            <p class="journal-card__meta">
              <span class="tag">{article.category}</span>
              <time datetime={new Date(article.publishedAt).toISOString()}>
                {formatDate(article.publishedAt)}
              </time>
              <span>{t.journal.readingTime(article.readingMinutes)}</span>
              <span class="article-meta__status">{t.journal.published}</span>
            </p>
            <h2>
              <a href={articleHref(article.slug)}>{article.title}</a>
            </h2>
            <p>{article.excerpt}</p>
            <a class="journal-card__link" href={articleHref(article.slug)}>
              {t.journal.read} <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
<script src="../../scripts/journal-filters.ts"></script>
