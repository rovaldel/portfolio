---
import { useLocale } from '../../lib/locale';

interface Props {
  backdrop?: boolean;
}
const { backdrop = false } = Astro.props;
const { t, c } = useLocale(Astro.url);
const { siteProfile, navigationActions } = c;
const homePortrait = {
  // This is the portrait selected for the public home page. Keep its AVIF
  // resource explicit so every compatible browser uses the same approved image;
  // bump the version when the source changes so caches drop the old file.
  src: '/images/rodrigo-valdelvira.avif?v=camisa-corbata-20260929',
  width: 1106,
  height: 1422,
};
const aboutAction = navigationActions.find((action) => action.id === 'about');
const projectsAction = navigationActions.find((action) => action.id === 'projects');

if (!aboutAction || !projectsAction) {
  throw new Error('Faltan las acciones conversacionales de portada.');
}
---

<section class="mockup-hero" aria-label={backdrop ? undefined : t.home.heroLabel}>
  <div class="mockup-hero__title">
    <span class="mockup-hero__spark" aria-hidden="true"
      ><svg viewBox="0 0 24 24"
        ><path d="M12 2c.6 5.4 4.6 9.4 10 10-5.4.6-9.4 4.6-10 10-.6-5.4-4.6-9.4-10-10 5.4-.6 9.4-4.6 10-10Z"
        ></path></svg
      ></span
    >
    <p class="eyebrow">{t.home.hello}</p>
    {
      backdrop ? (
        <p class="mockup-hero__heading">
          {t.home.headingLine1}
          <br />
          {t.home.headingLine2}
        </p>
      ) : (
        <h1>
          {t.home.headingLine1}
          <br />
          {t.home.headingLine2}
        </h1>
      )
    }
    <p class="mockup-hero__ask">{t.home.ask}</p>
  </div>
  <div class="mockup-hero__stage">
    <aside class="mockup-hero__quote">
      <p>{siteProfile.professionalSummary}</p>
      <strong>{siteProfile.experienceBadge}</strong>
    </aside>
    <div class="mockup-hero__portrait">
      <div class="portrait" data-image-frame>
        <img
          class="portrait__image"
          data-stable-image
          src={homePortrait.src}
          alt={backdrop ? '' : siteProfile.portrait.alt}
          width={homePortrait.width}
          height={homePortrait.height}
        />
        <span
          data-image-fallback
          class="image-fallback"
          role={backdrop ? undefined : 'img'}
          aria-label={backdrop ? undefined : siteProfile.portrait.fallbackLabel}
          hidden>{siteProfile.portrait.fallbackLabel}</span
        >
      </div>
    </div>
    <div class="mockup-hero__actions">
      <a
        class="button button--fill"
        href={aboutAction.destination}
        data-portfolio-action
        data-response={aboutAction.response}
        data-response-kind={aboutAction.responseKind}>{t.home.about}</a
      >
      <a
        class="button button--quiet"
        href={projectsAction.destination}
        data-portfolio-action
        data-response={projectsAction.response}
        data-response-kind={projectsAction.responseKind}>{t.home.viewProjects}</a
      >
    </div>
  </div>
</section>
<script src="../../scripts/image-fallback.ts"></script>
