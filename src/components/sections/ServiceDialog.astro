---
import type { Service } from '../../content/site';
import { useLocale } from '../../lib/locale';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { t, path } = useLocale(Astro.url);
---

<section
  class="service-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="service-modal-title"
  id="modal-content"
  tabindex="-1"
  data-service-dialog
>
  <a class="modal-close" href={path('services')} aria-label={t.sections.serviceClose}>×</a>
  <span class="service-card__icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={service.icon}></path>
    </svg>
  </span>
  <h2 id="service-modal-title">{service.title}</h2>
  <p class="muted">{service.summary}</p>
  <hr />
  <p data-service-description>{service.description}</p>
  <a
    class="button button--fill"
    href={path('contact') + '?asunto=' + service.slug}
    data-service-ask={service.slug}>{t.sections.serviceTalk}</a
  >
</section>
