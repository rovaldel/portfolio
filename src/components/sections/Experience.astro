---
import { formatMonthYear } from '../../lib/i18n';
import { useLocale } from '../../lib/locale';

const { locale, t, c } = useLocale(Astro.url);
const { experiences, internationalExperience } = c;

// One icon per role so the timeline reads at a glance: AI, data, product, buildings, research.
const icons: Record<string, string> = {
  cidatum:
    'M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6ZM18.5 15l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7Z',
  talenttools: 'M4 20h16M7 16v-5M12 16V7M17 16v-8',
  cmp: 'M4 16v-3.5L6 8h12l2 4.5V16ZM5 16v2.5M19 16v2.5M7.5 12.5h.01M16.5 12.5h.01',
  pope: 'M4 21V5l8-2v18M12 9h8v12M3 21h18M7.5 8h1M7.5 12h1M7.5 16h1M15.5 13h1M15.5 17h1',
  'gi-teneco': 'M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3M7.5 15h9',
};
const fallbackIcon = 'M3 8h18v12H3zM8 8V5h8v3M3 13h18';

// CV bullets that open with a short "Project: description" label get the label in bold.
const splitLabel = (text: string) => {
  const match = text.match(/^([^:.]{2,48}):\s+(.+)$/s);
  return match ? { label: match[1]!, rest: match[2]! } : { label: null, rest: text };
};
const showMode = (item: (typeof experiences)[number]) => item.current || item.workMode === 'remoto';
---

<section class="experience-list" aria-labelledby="experiencia-title">
  <h2 id="experiencia-title" class="sr-only">{t.sections.experienceTitle}</h2>
  {
    experiences.map((item) => (
      <details class="experience-item">
        <summary class="experience-item__summary">
          <span class="experience-item__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={icons[item.id] ?? fallbackIcon} />
            </svg>
          </span>
          <span class="experience-item__date meta">
            {formatMonthYear(item.start, locale)} — {formatMonthYear(item.end, locale)}
          </span>
          <span class="experience-item__identity">
            <strong>{item.role}</strong>
            <span>
              {item.organization}
              {item.organizationDetail ? ` (${item.organizationDetail})` : ''} · {item.location}
              {showMode(item) ? ' · ' + t.sections.workMode[item.workMode] : ''}
            </span>
          </span>
          <span class="experience-item__toggle" aria-hidden="true" />
        </summary>
        <div class="experience-item__body">
          <ul class="detail-list">
            {item.highlights.map((highlight) => {
              const { label, rest } = splitLabel(highlight);
              return (
                <li>
                  {label ? <strong>{label}:</strong> : null}
                  {label ? ' ' : ''}
                  {rest}
                </li>
              );
            })}
          </ul>
          {item.achievements?.length ? (
            <div class="experience-item__achievements">
              <h3>{t.sections.achievements}</h3>
              <ul class="detail-list">
                {item.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </div>
          ) : null}
        </div>
      </details>
    ))
  }
  <section class="international-experience" aria-labelledby="international-title">
    <h3 id="international-title">{t.sections.internationalTitle}</h3>
    <ul class="international-experience__list">
      {
        internationalExperience.map((stay) => (
          <li>
            <span class="international-experience__place">
              {stay.place}, {stay.country}
            </span>
            <span class="international-experience__meta">
              {stay.duration} · {stay.year}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</section>
