---
import { useLocale } from '../../lib/locale';

const { t, c } = useLocale(Astro.url);
const { skillGroups } = c;

const icons: Record<string, string> = {
  ia: 'M12 3v3M7 6h10a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3ZM9 11.5v1.5M15 11.5v1.5M9.5 16h5M2 11v4M22 11v4',
  datos: 'M4 6c0-4 16-4 16 0s-16 4-16 0Zm0 0v12c0 4 16 4 16 0V6M4 12c0 4 16 4 16 0',
  cloud: 'M3 12a5 5 0 0 1 5-5 6 6 0 0 1 11.7 1.5A4.5 4.5 0 0 1 19 17H8',
  desarrollo: 'm8 8-4 4 4 4m8-8 4 4-4 4m-3-6-2 4',
};
---

<section class="skills-catalog" data-visual-anchor="skills" aria-label={t.sections.skillsLabel}>
  {
    skillGroups.map((group) => (
      <article class="skills-catalog__group" data-skill-group={group.id}>
        <h2>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={icons[group.id] ?? icons.ia} />
          </svg>
          {group.name}
        </h2>
        <ul class="skills">
          {group.skills.map((skill) => (
            <li>
              <span>{skill.name}</span>
              <span class="skill-rating" role="img" aria-label={t.sections.skillLevel(skill.level)}>
                {Array.from({ length: 5 }, (_, index) => (
                  <svg
                    class:list={['skill-rating__star', index < skill.level && 'is-filled']}
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z" />
                  </svg>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
  <p class="skills-catalog__note">{t.sections.skillsNote}</p>
</section>
