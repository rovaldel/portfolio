---
import { education } from '../../content/site';
---

<section class="education-list" aria-labelledby="formacion-title">
  <h2 id="formacion-title" class="sr-only">Formación</h2>
  {
    education.map((item) => (
      <details class="education-item">
        <summary class="education-item__summary">
          <span class="education-item__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m2 9 10-5 10 5-10 5L2 9Z M6 11v5c3 3 9 3 12 0v-5" />
            </svg>
          </span>
          <span class="education-item__identity">
            <strong>{item.title}</strong>
            <span>{item.institution}</span>
          </span>
          <span class="education-item__date meta">{item.years}</span>
          <span class="education-item__toggle" aria-hidden="true" />
        </summary>
        <div class="education-item__body">
          <p>{item.description}</p>
        </div>
      </details>
    ))
  }
</section>
