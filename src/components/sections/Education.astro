---
import { education } from '../../content/site';

// Degrees get a graduation cap; certifications get a diploma.
const degreeIds = new Set(['mecanica', 'industrial', 'uemc']);
const capIcon = 'm2 9 10-5 10 5-10 5L2 9Z M6 11v5c3 3 9 3 12 0v-5';
const diplomaIcon =
  'M3 5h18v12h-4M3 5v12h9M7 9h10M7 12h5M16 12a2.5 2.5 0 1 0 0 .01M14.5 14.2 14 20l2-1.2 2 1.2-.5-5.8';
---

<section class="education-list" aria-labelledby="formacion-title">
  <h2 id="formacion-title" class="sr-only">Formación</h2>
  {
    education.map((item) => (
      <details class="education-item">
        <summary class="education-item__summary">
          <span class="education-item__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={degreeIds.has(item.id) ? capIcon : diplomaIcon} />
            </svg>
          </span>
          <span class="education-item__identity">
            <strong>{item.title}</strong>
            <span>{item.institution}</span>
          </span>
          <span class="education-item__date meta">{item.years}</span>
          <span class="education-item__toggle" aria-hidden="true" />
        </summary>
        <div class="education-item__body">
          <p>{item.description}</p>
        </div>
      </details>
    ))
  }
</section>
